{
  "name": "z-todo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @z-todo/desktop tauri dev",
    "dev:web": "pnpm --filter @z-todo/desktop dev",
    "build": "pnpm --filter @z-todo/desktop tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test -p zt-db --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "probe": "pnpm --filter @z-todo/desktop probe"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
