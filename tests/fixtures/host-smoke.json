    },
    {
      "name": "毫秒时间戳按整数绑定，参与运算时与整数一致",
      "steps": [
        {
          "query": "SELECT typeof(?) AS t, ? / 7 AS q, (? - ?) / 60000 AS minutes",
          "params": [
            1760000000000,
            1760000000000,
            1760000123456,
            1760000000000
          ],
          "expect": {
            "rows": [
              {
                "t": "integer",
                "q": 251428571428,
                "minutes": 2
              }
            ]
          }
        },
        {
          "query": "SELECT typeof(?) AS small, typeof(?) AS real",
          "params": [
            42,
            1.5
          ],
          "expect": {
            "rows": [
              {
                "small": "integer",
                "real": "real"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "参数个数必须与占位符一致",
      "steps": [
        {
          "query": "SELECT ? AS a, ? AS b",
          "params": [
            1
          ],
          "expect": {
            "error": {
              "kind": "sql"
            }
          }
        },
        {
          "query": "SELECT ? AS a",
          "params": [
            1,
            2
          ],
          "expect": {
            "error": {
              "kind": "sql"
            }
          }
        },
        {
          "query": "SELECT '?' AS literal, ? AS a",
          "params": [
            1
          ],
          "expect": {
            "rows": [
              {
                "literal": "?",
                "a": 1
              }
            ]
          }
        }
      ]
    },
    {
      "name": "一次只能执行一条语句；事务里的语句不能返回结果",
      "steps": [
        {
          "query": "SELECT 1 AS a; SELECT 2 AS b",
